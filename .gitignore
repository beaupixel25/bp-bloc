.DS_Store
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
# Build output in any package, not just the workspace root: `melos build`
# writes to packages/<pkg>/build/, which a root-anchored `/build/` misses.
build/
coverage/

# Generated code — build_runner output (freezed, json_serializable,
# go_router_builder). Regenerate with `melos build`; never hand-edit.
*.freezed.dart
*.g.dart

# Swift Package Manager
.build/
.swiftpm/
*.iml
.idea/

# Keep shared VSCode debug configs (launch.json) tracked, ignore the rest.
# A blanket `.vscode/` would exclude the directory outright and prevent any
# nested package from re-including its launch.json, so ignore contents instead.
**/.vscode/*
!**/.vscode/launch.json
pubspec.lock
.env
.env.local
*.swp
*.swo
